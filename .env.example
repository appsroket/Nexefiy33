# Nexefiy environment variables — TEMPLATE ONLY. Placeholders, never real values.
#
# Local:   copy to .env.local (git-ignored) and fill in what you need.
# Vercel:  Project → Settings → Environment Variables, per environment.
# Check:   npm run env:check   (add --connectivity for read-only provider checks)
#
# Only the CORE section is required. Every other section enables one feature;
# leave it blank and only that feature is disabled.
# Setup steps for each section: docs/credential-setup.md
#
# NEVER put a secret in a NEXT_PUBLIC_* variable — those are shipped to every
# browser. The app refuses to start if it detects one.

# ============================================================================
# CORE (required)                                docs/credential-setup.md#a-supabase
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Required in production. Defaults: http://localhost:3000 (development),
# https://$VERCEL_URL (preview).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: development | preview | production. Detected from VERCEL_ENV / NODE_ENV.
APP_ENV=

# ============================================================================
# SUPABASE PRIVILEGED ACCESS (server only)       docs/credential-setup.md#a-supabase
# Enables workers, webhooks, billing sync. Bypasses RLS — never NEXT_PUBLIC_.
# ============================================================================
SUPABASE_SECRET_KEY=
# Legacy projects only; ignored when SUPABASE_SECRET_KEY is set.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase CLI only (supabase link / db push). Not read by the app.
SUPABASE_DB_PASSWORD=

# ============================================================================
# AI MODEL PROVIDER (server only)                docs/credential-setup.md#b-ai-model-provider
# Only the selected provider's key is required.
# ============================================================================
# anthropic (default) or openai
AI_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ============================================================================
# EMBEDDINGS — Voyage AI (server only)            docs/credential-setup.md#b2-embeddings-voyage-ai
# Model voyage-4, 1024 dimensions (fixed by the database schema).
# ============================================================================
VOYAGE_API_KEY=

# ============================================================================
# EMAIL — Resend (server only)                   docs/credential-setup.md#c-email-resend
# ============================================================================
RESEND_API_KEY=
# e.g. "Nexefiy <notifications@mail.example.com>" — domain must be verified in Resend
EMAIL_FROM=

# ============================================================================
# WEBSITE CONTACT FORM (server only; needs EMAIL)  docs/credential-setup.md#c2-website-contact-form
# ============================================================================
# Inbox that receives contact-form messages, e.g. hello@example.com
CONTACT_FORM_TO=

# ============================================================================
# BILLING — Stripe                               docs/credential-setup.md#d-billing-stripe
# Test-mode keys outside production (live keys are rejected there).
# ============================================================================
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================================================
# CUSTOMER CREDENTIAL ENCRYPTION (server only)   docs/credential-setup.md#e1-customer-credential-encryption
# Required by every OAuth integration below. Generate: npm run env:generate-key
# Format: keyId:base64Key[,olderKeyId:base64Key...]  — back these up!
# ============================================================================
INTEGRATION_ENCRYPTION_KEYS=
INTEGRATION_ENCRYPTION_ACTIVE_KEY_ID=

# ============================================================================
# OPTIONAL INTEGRATIONS (server only)            docs/credential-setup.md#e-optional-integrations
# ============================================================================
# Google (Gmail, Calendar)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# HubSpot (CRM)
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# Background execution — Trigger.dev
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# Error monitoring — Sentry
SENTRY_DSN=

# Scheduled jobs — Vercel Cron sends "Authorization: Bearer $CRON_SECRET".
# Generate: openssl rand -base64 32
CRON_SECRET=
